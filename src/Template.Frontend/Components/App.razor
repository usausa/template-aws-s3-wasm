<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                @* The app is not usable until the authentication state has resolved, so keep
                   showing the exact same splash as index.html. The fixed-position cover hides
                   the already-rendered layout, making the hand-off from the static splash to
                   this one invisible. *@
                <Authorizing>
                    <div class="boot boot-cover">
                        <div class="boot-title">USER FILE PORTAL</div>
                        <div class="boot-bar"><span></span></div>
                        <div class="boot-note">Loading application</div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
    </Router>
</CascadingAuthenticationState>
