<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!-- The minimal UI has no reason to ship the ICU CJK data (243KB brotli).
         Dates are rendered with fixed invariant-culture formats. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Timestamps are displayed as UTC only; drop the bundled timezone database. -->
    <InvariantTimezone>true</InvariantTimezone>

    <!-- Native-compile on publish. Without AOT the startup work (auth service init,
         configuration binding, first renders) runs on the IL interpreter, and measurement
         showed that dominates the time from splash to first page render - network was idle
         for the whole stretch. AOT grows the download, which the immutable asset caching
         amortises to the first visit. Publish-only, so the inner dev loop stays fast. -->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CognitoIdentity" Version="4.0.100.7" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />

    <!-- Needed for AddHttpClient, which is how an AuthorizationMessageHandler gets an inner
         handler supplied. Attaching the token by hand would mean building the handler chain
         manually for no benefit. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>
